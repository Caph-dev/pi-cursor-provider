{
  "name": "pi-cursor-provider",
  "version": "0.3.0",
  "description": "Cursor provider for Pi: one HTTP/2 AgentService/Run per turn (magpie-aligned).",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "cursor",
    "magpie"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "main": "./src/index.ts",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.ts",
    "check": "tsc --noEmit",
    "test:e2e": "CURSOR_E2E=1 node --experimental-strip-types --test test/e2e-live.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^22.20.5",
    "typescript": "5.9"
  }
}
